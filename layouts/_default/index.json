{{- $pages := where .Site.RegularPages "Section" "in" (slice "posts" "articles") -}}
{{- $result := slice -}}
{{- range $pages -}}
  {{- $item := dict 
    "title" .Title
    "permalink" .RelPermalink
    "chinglish_phrase" (.Params.chinglish_phrase | default "")
    "chinese_meaning" (.Params.chinese_meaning | default "")
    "native_expression" (.Params.native_expression | default "")
    "category" (.Params.category | default "")
  -}}
  {{- $result = $result | append $item -}}
{{- end -}}
{{- $result | jsonify -}}